<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter for sie-operator.

  EI_EXPOSE_REP on Java records with Map fields:
  Record accessors are compiler-generated and cannot be overridden or annotated.
  All excluded records already use defensive copies (Collections.unmodifiableMap / Map.of)
  in their compact constructors, making the exposure safe. SpotBugs cannot verify
  runtime unmodifiability — this is a tool limitation, not a code defect.
-->
<FindBugsFilter>
  <Match>
    <Bug pattern="EI_EXPOSE_REP"/>
    <Or>
      <Class name="cloud.poesis.sie.operator.starlark.EffectRecord"/>
      <Class name="cloud.poesis.sie.operator.dto.OperationRequest"/>
    </Or>
  </Match>
</FindBugsFilter>
